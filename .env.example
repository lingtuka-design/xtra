# ==========================================
# Xtra Configuration & Secrets Guide
# ==========================================

# 1. Google Gemini AI (Google AI Studio Free Tier)
# Get free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_fallback_gemini_api_key_here

# 2. Facebook Page Auto-Poster (Meta Graph API)
# Get from Meta for Developers: https://developers.facebook.com/
# Requirements: pages_manage_posts, pages_read_engagement
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_never_expiring_page_access_token_here

# 3. Security (Optional)
# Secret key to protect manual or cron webhook triggers: /api/sync?secret=...
CRON_SECRET=your_custom_cron_secret_here

# 4. Sources configuration (comma-separated Twitter handles)
DEFAULT_SOURCES=David_Ornstein
