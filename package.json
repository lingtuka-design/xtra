{
  "name": "xtra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pages:dev": "wrangler pages dev dist --d1=DB=xtra-db",
    "deploy": "vite build && wrangler pages deploy dist",
    "d1:migrate:local": "wrangler d1 execute xtra-db --local --file=./schema.sql",
    "d1:migrate:prod": "wrangler d1 execute xtra-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.110.0"
  }
}
